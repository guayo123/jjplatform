{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/app.webmanifest",
      "has": [{ "type": "host", "value": "(www.)?jiujitsupuentealto.cl" }],
      "destination": "/manifests/academy-2.webmanifest"
    },
    {
      "source": "/apple-touch-icon",
      "has": [{ "type": "host", "value": "(www.)?jiujitsupuentealto.cl" }],
      "destination": "/icons/academy-2/apple-touch-icon.png"
    },
    {
      "source": "/app.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/apple-touch-icon",
      "destination": "/icons/apple-touch-icon.png"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/academies/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|Slackbot|TelegramBot|LinkedInBot|Discordbot).*"
        }
      ],
      "destination": "/api/og?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|Slackbot|TelegramBot|LinkedInBot|Discordbot).*"
        }
      ],
      "destination": "/api/og",
      "permanent": false
    }
  ]
}
